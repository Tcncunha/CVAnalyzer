# API keys are entered in the sidebar and stored in session only.
# Optionally set defaults below so they auto-load on startup.
# Tokens are NEVER written to disk by the app.

# Shared free key (Groq) — owner sets this once in .env (local) or
# Streamlit Secrets (cloud) so users need NO key at all.
# Analyzer/Builder/STAR use openai/gpt-oss-120b, Auto Match uses openai/gpt-oss-20b.
SHARED_GROQ_KEY=

OPENCODE_ZEN_API_KEY=
# Primary AI (tried first, falls back to SHARED_GROQ_KEY on any failure)
GEMINI_API_KEY=
OPENAI_API_KEY=
COPILOT_API_KEY=
ANTHROPIC_API_KEY=

# Adzuna Job Search API (free at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
