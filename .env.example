# AI routing order (all owner keys, all optional): OpenCode Zen -> Gemini -> shared Groq.
# Zen is SKIPPED unless enabled (free tier is blocked outside OpenCode).
# Only set ENABLE_OPENCODE=1 if you have a PAID Zen key.
# ENABLE_OPENCODE=1
OPENCODE_ZEN_API_KEY=
# Shared free key (Groq) — fallback so users need NO key at all.
# Analyzer/Builder/STAR use openai/gpt-oss-120b, Auto Match uses openai/gpt-oss-20b.
SHARED_GROQ_KEY=
# Primary AI (tried first, falls back to SHARED_GROQ_KEY on any failure)
GEMINI_API_KEY=
# Optional: override the Gemini primary model (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
COPILOT_API_KEY=
ANTHROPIC_API_KEY=

# Adzuna Job Search API (free at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
